# ── Data (raw data committed; interim & processed rebuilt from scripts) ────────
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python
build/
dist/
*.egg-info/
*.egg

# ── Jupyter ───────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb_checkpoints

# ── Environments ──────────────────────────────────────────────────────────────
.env
*.env
.venv/
venv/
env/

# ── MLflow ────────────────────────────────────────────────────────────────────
mlruns/
mlartifacts/

# ── Secrets and credentials ───────────────────────────────────────────────────
*.pem
*.key
kaggle.json
.kaggle/

# ── OS noise ──────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── IDEs ──────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
